{
  "uid": "velomagg-pipeline",
  "title": "Vélomagg : suivi du pipeline",
  "timezone": "Europe/Paris",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "velomagg",
    "gbfs"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Messages de statut reçus",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(status_valid), 0) as \"messages\"\n        from raw.ingest_batches where $__timeFilter(finished_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2B84B"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Doublons écartés",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(status_duplicates), 0) as \"doublons\"\n        from raw.ingest_batches where $__timeFilter(finished_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2B84B"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Messages rejetés (schéma)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as \"rejetés\" from raw.rejected_messages where $__timeFilter(rejected_at)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2B84B"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Stations suivies (10 dernières min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(distinct station_id) as \"stations\" from raw.station_status\n        where ingested_at > now() - interval '10 minutes'",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2B84B"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Relevés insérés par tranche de 5 min",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(ingested_at, '5m'), count(*) as \"relevés insérés\"\n        from raw.station_status where $__timeFilter(ingested_at) and not is_replay\n        group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latence de bout en bout (last_reported vers insertion)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select $__timeGroupAlias(ingested_at, '5m'),\n          percentile_cont(0.5) within group (order by extract(epoch from ingested_at - last_reported)) as \"p50\",\n          percentile_cont(0.95) within group (order by extract(epoch from ingested_at - last_reported)) as \"p95\",\n          percentile_cont(0.95) within group (order by extract(epoch from ingested_at - fetched_at))\n            as \"p95 pipeline seul\"\n        from raw.station_status where $__timeFilter(ingested_at) and not is_replay\n        group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Part des stations vides et pleines",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select last_reported as \"time\",\n          avg(case when is_installed and num_bikes_available = 0 then 1.0 else 0 end) as \"vides\",\n          avg(case when is_installed and num_docks_available = 0 then 1.0 else 0 end) as \"pleines\"\n        from raw.station_status where $__timeFilter(last_reported)\n        group by 1 order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Taux de remplissage moyen par heure (modèle dbt)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "velomagg-pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "velomagg-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select to_char(heure_locale, 'DD/MM HH24\"h\"') as \"heure\", taux_remplissage_moyen as \"remplissage\"\n            from marts.agg_reseau_horaire order by heure_locale",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#F2B84B"
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "heure",
        "orientation": "vertical",
        "showValue": "never",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": -45
      }
    }
  ]
}
