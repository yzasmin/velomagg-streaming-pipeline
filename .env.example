# Copier en .env pour changer les valeurs. Sans .env, docker compose utilise ces valeurs par défaut.
POSTGRES_DB=velomagg
POSTGRES_USER=velomagg
POSTGRES_PASSWORD=change-moi
GRAFANA_ADMIN_PASSWORD=change-moi
GBFS_ROOT=https://gbfs.theta.fifteen.eu/gbfs/2.2/montpellier/en
# Intervalle entre deux exécutions de dbt build (secondes)
DBT_INTERVAL_S=900
